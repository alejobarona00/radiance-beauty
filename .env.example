# Access Token de Mercado Pago (usa el de PRUEBA mientras testeas).
# Solo se lee en el servidor (app/api/checkout/route.ts) — nunca exponer al cliente.
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx

# ID del Pixel de Meta. Público a propósito (prefijo NEXT_PUBLIC_): se usa tanto
# en el cliente (layout.tsx) como en el servidor (app/api/checkout/route.ts, campo "tracks").
NEXT_PUBLIC_FB_PIXEL_ID=666994759187050

# Número de WhatsApp para el botón flotante, en formato internacional sin "+" ni espacios
# (ej: 573001234567). Público a propósito (prefijo NEXT_PUBLIC_): se usa en el cliente
# para construir el link wa.me. Si se deja vacío, el botón simplemente no se muestra.
NEXT_PUBLIC_WHATSAPP_NUMBER=573001234567
